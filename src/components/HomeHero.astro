---
import { Image, getImage } from "astro:assets";
import { SITE } from "../config";
import original from "../assets/hero/bambu-p2s-hero-v1.png";
import { homeFeaturedMedia } from "../home-featured-media";
import { HOME_FEATURED_MODEL_ID } from "../home-featured";
import CatPhoto from './CatPhoto.astro';

interface Props { featuredTitle?: string }
const media = homeFeaturedMedia();
const featuredTitle = media ? Astro.props.featuredTitle : undefined;
const printer = media?.printer ?? original;
const base = import.meta.env.BASE_URL;
const final = media && featuredTitle ? await getImage({ src: media.workshop, width: 1672, format: 'webp', quality: 85 }) : undefined;
---
<section class="home-story" data-home-motion={featuredTitle ? '' : undefined} aria-labelledby="hero-title">
  <div class="home-hero" data-stage>
    <div class="hero-visual" aria-hidden="true">
      <div class="scene-world">
        {featuredTitle && media && final ? <>
          <div class="printer-layer">
            <Image data-first src={printer} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" loading="eager" fetchpriority="high" />
            <img class="door-detail" data-src={media.door} width="1672" height="941" alt="" />
          </div>
          <img class="workshop-layer" data-src={final.src} width={final.attributes.width} height={final.attributes.height} alt="" />
          <div class="cat-layer"><CatPhoto photo={media.photo} /></div>
          <div class="glass-reflection"></div>
        </> : <Image src={original} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" loading="eager" fetchpriority="high" />}
      </div>
      <div class="emergency-image">
        <Image src={original} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" loading="lazy" />
      </div>
    </div>
    <span class="sr-only">{featuredTitle ? 'Иллюстрация: 3D-принтер, внутри робот-кот. При прокрутке — тот же напечатанный кот крупно на столе.' : 'Иллюстрация 3D-принтера в тёмной мастерской'}</span>
    <div class="wrap hero-copy">
      <div class="copy-content" data-intro>
        <p class="hero-eyebrow">Авторская 3D-печать</p>
        <h1 id="hero-title">Придумываю и печатаю вещи</h1>
        <p class="hero-description">{SITE.description} Здесь — как появилась каждая: идея, моделирование, печать и что пошло не так.</p>
        <div class="hero-actions" data-actions>
          <a class="btn" href={`${base}#models`}>Смотреть модели</a>
          {SITE.channel && <a class="btn btn-ghost" href={SITE.channel} target="_blank" rel="noopener">Telegram-канал</a>}
        </div>
      </div>
    </div>
    {featuredTitle && <div class="wrap final-caption" data-caption inert>
      <div>
        <p class="hero-eyebrow">Из принтера — в реальный мир</p>
        <h2>{featuredTitle}</h2>
        <a class="story-link" data-model-id={HOME_FEATURED_MODEL_ID} data-motion-source="hero" href={`${base}models/${HOME_FEATURED_MODEL_ID}/`}>История модели →</a>
      </div>
    </div>}
  </div>
</section>
<script>
  import '../scripts/home-motion';
</script>
<style>
.home-story { position: relative; background: var(--bg); }
.home-hero { position: relative; isolation: isolate; overflow: hidden; }
.hero-visual { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
.scene-world { position: absolute; top: -56px; width: max(100%, 900px); aspect-ratio: 16 / 9; left: 80%; transform: translateX(-80%); }
.printer-layer, .workshop-layer { position: absolute; inset: 0; width: 100%; height: 100%; }
.printer-layer { opacity: var(--printer-opacity, 1); transform: scale(var(--printer-scale, 1)); transform-origin: 71.5% 59%; }
.printer-layer img { width: 100%; height: 100%; }
.printer-layer .door-detail { position: absolute; inset: 0; opacity: var(--door-detail, 0); }
.workshop-layer { opacity: var(--workshop-opacity, 0); object-fit: cover; }
.cat-layer { position: absolute; height: var(--cat-height, 27%); aspect-ratio: 730 / 1490; left: var(--cat-x, 71.5%); bottom: var(--cat-bottom, 27%); transform: translateX(-50%); }
.cat-layer :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; filter: sepia(calc(var(--warmth, 1) * .12)) brightness(calc(1 - var(--warmth, 1) * .12)); }
.glass-reflection { position: absolute; left: 52%; top: 26%; width: 35%; height: 65%; opacity: var(--reflection, 0); background: linear-gradient(115deg, transparent 35%, #d5d9df88 48%, transparent 65%); transform: skewX(-8deg); }
.hero-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, var(--bg) 25%, #0d0d12cc 50%, transparent 80%), linear-gradient(180deg, var(--bg), transparent 8%); }
.emergency-image { display: none; position: absolute; inset: 0; }
.emergency-image img { width: 100%; height: 100%; object-fit: cover; object-position: 80% top; }
[data-failed] .scene-world { display: none; }
[data-failed] .emergency-image { display: block; }
.hero-copy { position: relative; padding-block: clamp(190px, 52vw, 320px) 8px; }
.hero-eyebrow { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 16px; }
.hero-copy h1 { font-size: clamp(2rem, 1.2rem + 3.4vw, 3rem); line-height: 1.1; font-weight: 800; letter-spacing: -.025em; max-width: 15ch; margin: 0 0 20px; }
.hero-description { color: var(--muted); font-size: clamp(15px, 14.2px + .1vw, 16px); line-height: 1.55; max-width: 52ch; margin: 0 0 24px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.final-caption { display: none; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
@media (min-width: 1024px) {
  .home-hero { min-height: 500px; display: flex; align-items: center; }
  .scene-world { width: min(100%, 888.8889px); left: auto; right: 0; transform: translateY(-50%); bottom: auto; top: 50%; }
  .hero-visual::after { background: linear-gradient(90deg, var(--bg) 10%, #0d0d12eb 32%, transparent 65%), linear-gradient(0deg, var(--bg), transparent 25%); }
  .hero-copy { width: 100%; padding-block: 40px; }
  .copy-content { width: 44%; }
}
:global(html.home-motion) .home-story { height: 300svh; }
:global(html.home-motion) .home-hero { height: 100svh; position: sticky; top: 0; min-height: 0; }
:global(html.home-motion) .scene-world { width: min(100%, 177.7778svh); left: 50%; right: auto; top: auto; bottom: 0; transform: translateX(-50%); }
:global(html.home-motion) .hero-visual::after { background: linear-gradient(90deg, #0d0d12d9, #0d0d1266 35%, transparent 60%); }
:global(html.home-motion) .copy-content { opacity: var(--intro-opacity, 1); }
:global(html.home-motion) .final-caption { display: block; position: absolute; left: 0; right: 0; top: 44%; opacity: var(--caption-opacity, 0); pointer-events: none; }
:global(html.home-motion) .final-caption > div { max-width: 30%; }
:global(html.home-motion) .final-caption:not([inert]) { pointer-events: auto; }
.final-caption h2 { font-size: clamp(24px, 2.4vw, 38px); margin: 0 0 24px; }
.story-link { color: var(--accent); text-underline-offset: 6px; font-weight: 600; }
@media (prefers-reduced-motion: reduce) {
  :global(html.home-motion) .home-story { height: auto; }
  :global(html.home-motion) .home-hero { position: relative; height: auto; min-height: 500px; }
}
</style>
