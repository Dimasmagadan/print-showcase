---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
import { getModels } from "../lib";

const models = await getModels();
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="wrap hero">
    <h1>Придумываю и печатаю вещи</h1>
    <p>{SITE.description} Здесь — как появилась каждая: идея, моделирование, печать и что пошло не так.</p>
    {(SITE.contact || SITE.channel) && (
      <div class="hero-actions">
        {SITE.contact && <a class="btn" href={SITE.contact} target="_blank" rel="noopener">Связаться</a>}
        {SITE.channel && <a class="btn btn-ghost" href={SITE.channel} target="_blank" rel="noopener">Telegram-канал</a>}
      </div>
    )}
  </section>

  <section class="wrap">
    {models.length === 0 && <p class="empty">Первые модели скоро появятся.</p>}
    <div class="grid">
      {models.map((m) => (
        <a class="card" href={`${base}models/${m.id}/`}>
          <Image class={`fit-${m.data.coverFit}`} src={m.data.cover} alt={m.data.coverAlt} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 360px" />
          <div class="card-body">
            <h2>{m.data.title}</h2>
            <p>{m.data.summary}</p>
            <ul class="tags">{m.data.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
