---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getModels } from "../lib";
import { HOME_FEATURED_MODEL_ID, orderHomeModels } from "../home-featured";
import HomeMotionHead from "../components/HomeMotionHead.astro";
import { homeFeaturedMedia } from "../home-featured-media";
import HomeHero from "../components/HomeHero.astro";

const { models, featured } = orderHomeModels(await getModels());
if (!featured) {
  console.warn(`[home] Published featured model "${HOME_FEATURED_MODEL_ID}" is unavailable; using the ordinary catalog.`);
}
const sceneEnabled = Boolean(featured && homeFeaturedMedia());
if (featured && !sceneEnabled) console.warn(`[home] No reviewed media for "${HOME_FEATURED_MODEL_ID}"; using the static hero.`);
const base = import.meta.env.BASE_URL;
---
<Base home>
  <HomeMotionHead slot="head" enabled={sceneEnabled} />
  <HomeHero featuredTitle={featured?.data.title} />

  <section class="wrap home-models" id="models" aria-labelledby="models-title">
    <div class="catalog-heading">
      <h2 id="models-title">Все модели</h2>
      <p>Всего: {models.length}</p>
    </div>
    {models.length === 0 && <p class="empty">Первые модели скоро появятся.</p>}
    <div class="model-grid">
      {models.map((m) => (
        <a class="model-card" data-model-id={m.id} data-cover-key={m.data.cover.src} data-motion-source="catalog" href={`${base}models/${m.id}/`}>
          <div class="model-card-image">
            <Image class={`fit-${m.data.coverFit}`} src={m.data.cover} alt={m.data.coverAlt} widths={[320, 480, 640]} sizes="(max-width: 767px) min(78vw, 320px), (max-width: 1023px) calc((100vw - 96px) / 3), (max-width: 1440px) calc((100vw - 156px) / 4), 321px" loading="lazy" />
          </div>
          <h3><span data-model-title>{m.data.title}</span></h3>
          <p>{[m.data.specs.material, m.data.tags[0]].filter(Boolean).join(" · ")}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
